#!/bin/sh
# _diffy-delta: terminal pretty diff wrapper using git-delta
# Usage: _diffy-delta <FROM> <TO>
#
# Pipes a unified diff through delta for beautiful side-by-side,
# word-level, syntax-highlighted terminal output.
#
# Environment:
#   DELTA_OPTS  - override delta options (replaces defaults)
#   DELTA_PATH  - path to delta binary (default: auto-detect)

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

# Exit-code contract (shared): 0 identical, 1 diff, 2 usage, 3 bad input, 4 internal.

# --- Help ---
case "${1:-}" in
    -h|--help)
        echo "_diffy-delta — terminal side-by-side diff via git-delta"
        echo "Usage: _diffy-delta <FROM> <TO>"
        echo
        echo "Pipes 'git diff --no-index' through git-delta for side-by-side,"
        echo "word-level highlighted output in the terminal."
        echo
        echo "Environment: DELTA_OPTS (delta flags), DELTA_PATH (binary)."
        echo "Exit codes: 0 identical · 1 diff · 2 usage · 3 bad input · 4 internal"
        exit 0
        ;;
esac

# --- Validate arguments ---
usage() {
    echo "Usage: _diffy-delta <FROM> <TO>" >&2
    echo "       _diffy-delta --help" >&2
}
if [ $# -ne 2 ]; then
    usage
    if [ $# -eq 0 ]; then
        echo "error: missing both <FROM> and <TO>" >&2
    else
        echo "error: expected exactly 2 arguments, got $#" >&2
    fi
    exit 2
fi

FROM_FILE="$1"
TO_FILE="$2"

check_input() {
    # $1 = path, $2 = label (FROM/TO)
    if [ ! -e "$1" ]; then
        echo "error: $2 not found: $1" >&2
        exit 3
    fi
    if [ ! -f "$1" ]; then
        echo "error: $2 is not a regular file (is it a directory?): $1" >&2
        exit 3
    fi
}
check_input "$FROM_FILE" FROM
check_input "$TO_FILE" TO

# --- Resolve delta binary ---
DELTA_BIN="${DELTA_PATH:-}"
VENDORED="$SCRIPT_DIR/diffbin/delta"
if [ -z "$DELTA_BIN" ]; then
    if [ -x "$VENDORED" ]; then
        DELTA_BIN="$VENDORED"
    elif command -v delta >/dev/null 2>&1; then
        DELTA_BIN="delta"
    fi
fi

delta_available() {
    # Distinguish an absolute/path binary (check -x) from a PATH command.
    case "$1" in
        */*) [ -x "$1" ] && return 0 || return 1 ;;
        *)   command -v "$1" >/dev/null 2>&1 ;;  # on PATH
    esac
}
if [ -z "$DELTA_BIN" ] || ! delta_available "$DELTA_BIN"; then
    echo "error: delta is not installed or not on PATH." >&2
    echo "" >&2
    echo "Install delta with one of these methods:" >&2
    echo "  apt:    sudo apt-get install -y git-delta" >&2
    echo "  binary: download from https://github.com/dandavison/delta/releases/latest" >&2
    echo "          (linux-x86_64 tar.gz, extract and copy to $SCRIPT_DIR/diffbin/delta)" >&2
    echo "" >&2
    echo "Or set DELTA_PATH to the full path of the delta binary." >&2
    exit 4
fi

# --- Run the diff through delta ---
# git diff --no-index exit codes:
#   0 = files are identical
#   1 = files differ (expected, not an error)
#   2+ = error
# We use a temp file to capture diff output so we can check
# git diff's exit code separately from delta's.
DIFF_TEMP="$(mktemp)"
trap 'rm -f "$DIFF_TEMP"' EXIT

git diff --no-index --unified=2 --color=always --text "$FROM_FILE" "$TO_FILE" > "$DIFF_TEMP"
GIT_EXIT=$?

if [ "$GIT_EXIT" -eq 0 ]; then
    # Files are identical — no diff output to show
    rm -f "$DIFF_TEMP"
    exit 0
elif [ "$GIT_EXIT" -ne 1 ]; then
    # git diff error
    rm -f "$DIFF_TEMP"
    exit "$GIT_EXIT"
fi

# Files differ — display through delta
if [ -n "${DELTA_OPTS+x}" ]; then
    $DELTA_BIN $DELTA_OPTS < "$DIFF_TEMP"
else
    TERM_WIDTH="${COLUMNS:-$(tput cols 2>/dev/null || echo 120)}"
    $DELTA_BIN --side-by-side --word-diff-regex='[[:alnum:]_]+' --width="$TERM_WIDTH" < "$DIFF_TEMP"
fi
DELTA_EXIT=$?

# Propagate delta's own exit code; if delta succeeded (exit 0), report files differ (exit 1)
if [ "$DELTA_EXIT" -ne 0 ]; then
    exit "$DELTA_EXIT"
fi
exit 1
