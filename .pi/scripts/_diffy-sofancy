#!/bin/sh
# _diffy-sofancy — terminal pretty diff via diff-so-fancy
# Usage: _diffy-sofancy <FROM> <TO>
# Pipes git diff --no-index through diff-so-fancy for cleaner hunks.
# Exit codes: 0 identical · 1 diff · 2 usage · 3 bad input · 4 internal.

set -u

# --- Help ---
case "${1:-}" in
    -h|--help)
        printf '_diffy-sofancy — terminal pretty diff via diff-so-fancy\n'
        printf 'Usage: _diffy-sofancy <FROM> <TO>\n'
        printf '\n'
        printf 'Pipes "git diff --no-index" through diff-so-fancy for cleaner hunks.\n'
        printf 'Exit codes: 0 identical · 1 diff · 2 usage · 3 bad input · 4 internal\n'
        printf '\n'
        printf 'Install diff-so-fancy with:  npm install -g diff-so-fancy\n'
        exit 0
        ;;
esac

# Require exactly two arguments (before touching anything else).
if [ $# -ne 2 ]; then
    printf 'Usage: _diffy-sofancy <FROM> <TO>\n' >&2
    if [ $# -eq 0 ]; then
        printf 'error: missing both <FROM> and <TO>\n' >&2
    else
        printf 'error: expected exactly 2 arguments, got %s\n' "$#" >&2
    fi
    exit 2
fi

# Check that diff-so-fancy is available.
if ! command -v diff-so-fancy >/dev/null 2>&1; then
    printf '_diffy-sofancy: diff-so-fancy is not installed.\n' >&2
    printf '  Install it with:  npm install -g diff-so-fancy\n' >&2
    printf '  Or:               sudo apt-get install -y diff-so-fancy\n' >&2
    exit 4
fi

# Sort arguments so the diff order is deterministic regardless of caller order.
# This ensures "FROM" is always the lexicographically earlier path.
if [ "$1" \> "$2" ]; then
    FROM="$2"
    TO="$1"
else
    FROM="$1"
    TO="$2"
fi

# Verify both operands are regular files (distinguish missing vs directory).
check_input() {
    # $1 = path, $2 = label (FROM/TO)
    if [ ! -e "$1" ]; then
        printf '_diffy-sofancy: %s not found: %s\n' "$2" "$1" >&2
        exit 3
    fi
    if [ ! -f "$1" ]; then
        printf '_diffy-sofancy: %s is not a regular file (is it a directory?): %s\n' "$2" "$1" >&2
        exit 3
    fi
}
check_input "$FROM" FROM
check_input "$TO" TO

# Run git diff, capture output to a temp file so we can preserve its exit code.
# git diff --no-index returns 0 when identical, 1 when a diff exists (expected),
# and >=2 on a real error (e.g. input vanished).
tmpfile=$(mktemp) || {
    printf '_diffy-sofancy: mktemp failed (TMPDIR unwritable?)' >&2
    printf '\n' >&2
    exit 4
}

git diff --no-index --unified=2 --color=always --text "$FROM" "$TO" > "$tmpfile"
GIT_EXIT=$?

if [ "$GIT_EXIT" -ge 2 ]; then
    printf '_diffy-sofancy: git diff failed (exit %s) — inputs may have changed' "$GIT_EXIT" >&2
    printf '\n' >&2
    rm -f "$tmpfile"
    exit 4
fi

# Pipe the captured diff through diff-so-fancy for pretty printing.
cat "$tmpfile" | diff-so-fancy
rm -f "$tmpfile"

# Preserve the real git diff exit code (0 = identical, 1 = diff exists).
exit "$GIT_EXIT"
