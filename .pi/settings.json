{
  "defaultProvider": "openrouter",
  "defaultModel": "deepseek/deepseek-v4-flash",
  "enabledModels": [
    "deepseek/deepseek-v4-flash",
    "inclusionai/ling-3.0-flash",
    "stealth/ox-alpha",
    "upstage/solar-pro4",
    "inception/*"
  ],
  "subagents": {
    "defaultProvider": "openrouter",
    "agentOverrides": {
      "oracle":     { "model": "deepseek/deepseek-v4-flash" },
      "reviewer":   { "model": "deepseek/deepseek-v4-flash" },
      "worker":     { "model": "inclusionai/ling-3.0-flash" },
      "researcher": { "model": "inclusionai/ling-3.0-flash" },
      "scout":      { "model": "inclusionai/ling-3.0-flash" },
      "delegate":   { "model": "inherit" }
    }
  },
  "packages": [
    "npm:pi-web-access",
    "npm:pi-subagents"
  ],
  "skills": [
    "s",
    "./skills/findtree"
  ],
  "extensions": [
    "./extensions/openrouter-free-analysis.ts",
    "./extensions/findtree.ts"
  ]
}
