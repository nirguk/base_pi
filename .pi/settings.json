{
  "defaultProvider": "openrouter",
  "defaultModel": "deepseek/deepseek-v4-flash-0731",
  "enabledModels": [
    "deepseek/deepseek-v4-flash-0731",
    "inclusionai/ling-3.0-flash",
    "z-ai/glm-5.3-flash",
    "upstage/solar-pro4",
    "poolside/*",
    "inception/*"
  ],
  "subagents": {
    "defaultProvider": "openrouter",
    "agentOverrides": {
      "oracle": {
        "model": "deepseek/deepseek-v4-flash-0731"
      },
      "reviewer": {
        "model": "deepseek/deepseek-v4-flash-0731"
      },
      "worker": {
        "model": "inclusionai/ling-3.0-flash"
      },
      "researcher": {
        "model": "inclusionai/ling-3.0-flash"
      },
      "scout": {
        "model": "inclusionai/ling-3.0-flash"
      },
      "delegate": {
        "model": "inherit"
      }
    }
  },
  "packages": [
    "npm:pi-web-access",
    "npm:pi-subagents",
    "git:github.com/nirguk/pi-session-analyzer"
  ],
  "skills": [
    "s",
    "./skills/findtree"
  ],
  "extensions": [
    "./extensions/openrouter-free-analysis.ts",
    "./extensions/findtree.ts",
    "!extensions/or-live/**",
    "./extensions/poolside-laguna-compact.ts"
  ]
}