{
  "projects": {
    "/workspaces/PlantWise": {
      "alias": "plantwise",
      "label": "PlantWise",
      "exts": [".cs"],
      "containerPath": "/workspaces/PlantWise",
      "mapCommand": ["dotnet", "run", "--project", "tools/MethodMap", "--", "PlantWise"],
      "mapTimeoutMs": 120000
    },
    "/workspaces/image_forge": {
      "alias": "image_forge",
      "label": "image_forge",
      "exts": [".py"],
      "containerPath": "/workspaces/image_forge"
    },
    "/workspaces/congruent_roster": {
      "alias": "congruent_roster",
      "label": "congruent_roster",
      "exts": [".py"],
      "containerPath": "/workspaces/congruent_roster",
      "mapCommand": ["python3", "tools/methodmap.py", "."],
      "mapTimeoutMs": 120000
    }
  }
}
