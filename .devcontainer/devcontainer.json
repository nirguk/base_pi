{
  "name": "Ubuntu & Node (Cached)",
  "build": {
    "context": ".",
    "dockerfile": "Dockerfile"
  },
  "remoteUser": "vscode",
  "mounts": [
    "source=/var/run/docker.sock,target=/var/run/docker.sock,type=bind",
    "source=${localEnv:BASE_FOLDER}/congruent_roster,target=/workspaces/congruent_roster,type=bind",
    "source=${localEnv:BASE_FOLDER}/nirgraham_career,target=/workspaces/nirgraham_career,type=bind",
    "source=${localEnv:BASE_FOLDER}/penpalagent,target=/workspaces/penpalagent,type=bind",
    "source=${localEnv:BASE_FOLDER}/pi-audit,target=/workspaces/pi-audit,type=bind",
    "source=${localEnv:BASE_FOLDER}/dsh_cv,target=/workspaces/dsh_cv,type=bind",
    "source=${localEnv:BASE_FOLDER}/c#/PlantWise,target=/workspaces/PlantWise,type=bind"
  ],
  "runArgs": [],
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "26"
    }
  },
  "postCreateCommand": "./.devcontainer/setup.sh",
  "postStartCommand": "./.devcontainer/healthcheck.sh",
  "customizations": {
    "vscode": {
      "extensions": []
    }
  },
  "containerEnv": {
    "BASE_FOLDER": "${localEnv:BASE_FOLDER:-/workspaces}",
    "OPENROUTER_API_KEY": "${localEnv:OPENROUTER_API_KEY}",
    "INCEPTION_API_KEY": "${localEnv:INCEPTION_API_KEY}",
    "GH_TOKEN" : "${localEnv:GITHUB_PAT_TOKEN}",
    "GH_USER" : "${localEnv:GITHUB_USERNAME}",
    "PI_LLM_DEBUGGING_FOOTER" : "0",
    "XDG_CONFIG_HOME": "/workspaces/base_pi/.pi",
    "NOVITA_API_KEY": "${localEnv:NOVITA}",
    "PI_CODING_AGENT_DIR" : "/workspaces/base_pi/.pi",
    "DOCKER_HOST": "unix:///var/run/docker.sock",
    "UV_PYTHON_INSTALL_DIR": "/opt/uv-python"
  }
}